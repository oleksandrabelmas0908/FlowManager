DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/flowmanager
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=flowmanager

# LinkedIn credentials for job application automation
LINKEDIN_EMAIL=your.email@example.com
LINKEDIN_PASSWORD=your_password

# Preferred auth: paste your `li_at` session cookie (DevTools -> Application ->
# Cookies -> https://www.linkedin.com). Lets the tasks skip login + CAPTCHA.
# Run `python scripts/linkedin_session.py` once to persist the session.
# LINKEDIN_LI_AT=your_li_at_cookie_value

# Optional: path to your CV PDF (defaults to the uploaded file path)
# LINKEDIN_CV_PATH=/path/to/your/cv.pdf
